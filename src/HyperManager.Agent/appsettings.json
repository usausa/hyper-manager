{
  "http_ports": "5100",

  "AllowedHosts": "*",

  "Agent": {
    "ApiKey": ""
  },

  "HyperV": {
    "JobTimeoutSeconds": 300,
    "JobPollIntervalMilliseconds": 200
  },

  "Log": {
    "HttpLog": false
  },

  "Prometheus": {
    "Uri": ""
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/HyperManager.Agent_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
